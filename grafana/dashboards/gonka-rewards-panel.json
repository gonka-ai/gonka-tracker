          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  time AS \"time\",\n  node_address AS metric,\n  CASE \n    WHEN assigned_reward_gnk > 0 AND claimed = true THEN 100.0\n    WHEN assigned_reward_gnk > 0 THEN 0.0\n    ELSE 0\n  END AS \"Claim Rate %\"\nFROM participant_rewards\nWHERE $__timeFilter(time)\n  AND assigned_reward_gnk > 0\nORDER BY time, epoch_id",
          "refId": "A"
        }
      ],
      "title": "Reward Rate (Rewarded / Earned)",
      "type": "timeseries"
