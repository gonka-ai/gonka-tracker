            "type": "postgres",
            "uid": "PostgreSQL"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n  node_address AS \"Participant\",\n  SUM(assigned_reward_gnk) / 1000000000.0 AS \"Total Assigned (GNK)\",\n  SUM(CASE WHEN claimed THEN assigned_reward_gnk ELSE 0 END) / 1000000000.0 AS \"Total Claimed (GNK)\",\n  COUNT(*) AS \"Epochs with Rewards\",\n  SUM(CASE WHEN claimed THEN 1 ELSE 0 END) AS \"Claimed Epochs\"\nFROM participant_rewards\nWHERE $__timeFilter(time)\nGROUP BY node_address\nORDER BY \"Total Assigned (GNK)\" DESC",
          "refId": "A"
        }
      ],
      "title": "Total Rewards Summary",
      "type": "table"
